+    public TestListaEstudiante() {
+        random = new Random();
+        total = 10 + random.nextInt(90);
+        lista = new ListaEstudiante();
+    }
+
+    /**
+     * Prueba unitaria para {@link ListaEstudiante#ListaEstudiante}.
+     */
+    @Test public void testConstructor() {
