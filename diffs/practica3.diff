+        Assert.assertTrue(c == longitud);
+        c = 0;
+        nodo = lista.getCabeza();
+        while (nodo != null) {
+            Assert.assertTrue(arreglo[c++].equals(nodo.get()));
+            nodo = nodo.getSiguiente();
+        }
+        Assert.assertTrue(c == longitud);
+        c = longitud - 1;
+        nodo = lista.getRabo();
+        while (nodo != null) {
+            Assert.assertTrue(arreglo[c--].equals(nodo.get()));
+            nodo = nodo.getAnterior();
